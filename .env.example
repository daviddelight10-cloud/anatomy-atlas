# Anatomy Atlas — auth & payments configuration
#
# These values live inside index.html (search for "SUPA_URL"). They are PUBLIC
# keys — safe to ship in client code. The Paystack SECRET key never goes here;
# it is set as a Supabase Edge Function secret instead.

# --- Supabase (Dashboard → Project Settings → API) ---
SUPA_URL="https://YOUR-PROJECT.supabase.co"
SUPA_ANON_KEY="your-anon-public-key"

# Edge function base URL = SUPA_URL + "/functions/v1/verify-payment"
# Server-side secret (NEVER in client code):
#   supabase secrets set PAYSTACK_SECRET_KEY="sk_test_..."

# --- Paystack (Dashboard → Settings → API Keys & Webhooks) ---
# Same business account as Scholar's Circle. Use pk_test_ while developing.
PAYSTACK_PK="pk_test_your_public_key"
